# Jadwal notifikasi: 06.00, 09.00, 12.00, 15.00, dan 18.00 WIB.
#
# Memakai systemd timer, bukan cron, karena cron Debian/Ubuntu (3.0pl1) TIDAK
# mendukung penentuan zona waktu per-crontab — man 5 crontab menyatakannya
# eksplisit, dan CRON_TZ diabaikan. Jadwal cron akan mengikuti zona waktu host,
# yang di VPS ini Europe/Berlin dan ikut bergeser saat DST, sehingga jam
# notifikasi jadi salah dan berubah dua kali setahun.
#
# OnCalendar systemd menerima nama zona waktu, jadi jamnya bisa ditulis langsung
# dalam WIB dan dihitung benar sepanjang tahun tanpa mengubah zona waktu host
# (yang dipakai bersama aplikasi lain di server ini).
[Unit]
Description=Jadwal notifikasi harian Jadwal Belajar (WIB)

[Timer]
OnCalendar=*-*-* 06,09,12,15,18:00:00 Asia/Jakarta
AccuracySec=30s
# Sengaja tidak Persistent: pengingat "selamat pagi" yang menyusul terkirim
# siang hari sesudah server sempat mati lebih mengganggu daripada terlewat.
Persistent=false

[Install]
WantedBy=timers.target
