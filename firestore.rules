rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data belajar tiap user — hanya pemilik yang bisa baca/tulis.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Token FCM per perangkat. Client hanya boleh mendaftarkan/menghapus
    // token miliknya sendiri; pembacaan hanya lewat Admin SDK (GitHub Action),
    // jadi read dari client ditutup.
    match /fcmTokens/{token} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
